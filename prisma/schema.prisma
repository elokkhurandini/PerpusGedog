generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// Kode client dan datasource di atas jangan dihapus atau diubah  
enum StatusPeminjaman {
  dipinjam
  dikembalikan
}

model Peminjaman {
  id                  Int              @id @default(autoincrement())
  judulBuku           String
  pengarang           String
  penerbit            String
  namaSiswa           String
  kelas               String
  tanggalPinjam       DateTime
  tanggalKembali      DateTime
  tanggalDikembalikan DateTime?
  status              StatusPeminjaman @default(dipinjam)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Kunjungan {
  id        Int      @id @default(autoincrement())
  kelas     String
  tanggal   DateTime
  jam       String
  guru      String
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}